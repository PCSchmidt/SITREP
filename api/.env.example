# SITREP Backend Environment Variables
# Copy this file to .env and fill in your values

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Open Router API (LLM Synthesis)
OPENROUTER_API_KEY=your_openrouter_api_key

# Railway/Render Deployment
PORT=8000
HOST=0.0.0.0

# Admin shared secret for pipeline and debug endpoints (/scrape, /synthesize,
# /briefing/generate-pdf, /pipeline/run-weekly, /debug/*). When set, callers must
# send the same value in the X-Admin-Token header. Leave unset to keep those
# endpoints open (current behaviour) until every caller is updated.
SITREP_ADMIN_TOKEN=

# Development
DEBUG=True
