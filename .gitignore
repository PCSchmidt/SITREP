# SITREP Project Gitignore

# Python Backend
api/__pycache__/
api/*.py[cod]
api/*$py.class
api/venv/
api/.venv/
api/ENV/
api/.pytest_cache/
api/.coverage
api/htmlcov/
api/*.egg-info/
api/.env

# Node/React Native Mobile
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/web-build/
mobile/expo-env.d.ts
mobile/.metro-health-check*
mobile/mobile/

# Logs
*.log
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
*.pem

# Environment
.env
.env.local
.env.*.local

# Build artifacts
build/
dist/

# Temporary
*.tmp
*.temp
.cache/

# App Store / EAS secrets (never commit these)
mobile/google-service-account.json
mobile/*.p8
mobile/*.p12
mobile/*.mobileprovision

# --- Cleanup 2026-06-01 ---
# Python caches anywhere (not just top-level api/)
**/__pycache__/
*.py[cod]
# Local virtualenvs anywhere
**/venv/
**/.venv/
# Generated briefing artifacts (regenerated by the pipeline; not source)
api/data/pdfs/
api/data/scraped/
api/data/briefings/
data/pdfs/
data/scraped/
data/briefings/
# Generated / scratch PDFs
test_*.pdf
mobile/test_*.pdf
# Claude Code runtime state (not project source)
.claude/state/
.claude/scheduled_tasks.lock
.claude/*.lock
