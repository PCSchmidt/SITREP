# SITREP Project Gitignore

# Python Backend
api/__pycache__/
api/*.py[cod]
api/*$py.class
api/venv/
api/.venv/
api/ENV/
api/.pytest_cache/
api/.coverage
api/htmlcov/
api/*.egg-info/
api/.env

# Node/React Native Mobile
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/web-build/
mobile/expo-env.d.ts
mobile/.metro-health-check*
mobile/mobile/

# Logs
*.log
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
*.pem

# Environment
.env
.env.local
.env.*.local

# Build artifacts
build/
dist/

# Temporary
*.tmp
*.temp
.cache/

# App Store / EAS secrets (never commit these)
mobile/google-service-account.json
mobile/*.p8
mobile/*.p12
mobile/*.mobileprovision
