# SITREP API Environment Variables
# Copy this file to .env and fill in your actual values

# Open Router API Key
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Supabase (v0.6+). The backend writes briefings, so the service key is the one that
# matters: SUPABASE_KEY (publishable/anon) fails writes with RLS error 42501.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your_service_role_key_here
# SUPABASE_KEY=your_publishable_key_here

# Optional: require X-Admin-Token on write/debug endpoints
# SITREP_ADMIN_TOKEN=

# Future integrations
# ANTHROPIC_API_KEY=your_anthropic_key_here (if using direct SDK)
